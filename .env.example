# ISEXY web build variables (Vite). Every VITE_* value is baked into the
# public JavaScript: never put a secret here. Function secrets (Stripe, Claude,
# Resend, Twilio, VAPID private key, cron) live on TAKATAK V1 as ISEXY_* names
# (docs/HANDOFF.md › Needs the owner). Where to set these for each host:
# docs/DEPLOYMENT.md › Variables (GitHub variables for CI, Coolify / Render
# build environment). `.env` (committed) holds the public V1 defaults.

# --- TAKATAK V1 (already set in .env; override only on purpose) -------------
# VITE_SUPABASE_PROJECT_ID=pcjfahhlozsseqqevimi
# VITE_SUPABASE_URL=https://pcjfahhlozsseqqevimi.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<V1 anon key, see .env>
# VITE_SITE_URL=https://isexy.ca

# --- Analytics (optional, only with the visitor's consent) -------------------
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# --- Push (public half of the VAPID pair; the private key is a V1 secret) ----
VITE_VAPID_PUBLIC_KEY=

# --- Calls (TURN strongly recommended for calls on mobile data) --------------
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_STUN_URL=
VITE_TURN_RELAY_ONLY=
VITE_PHONE_LINE_NUMBER=

# --- Ads (docs/ADS.md). Free members only; paying members never see ads. ----
# TAKATAK ad server (first choice). Defaults: https://takatak.ca, publisher "isexy", on.
VITE_TAKATAK_ADS_URL=https://takatak.ca
VITE_TAKATAK_ADS_PUBLISHER=isexy
VITE_TAKATAK_ADS_ENABLED=true
# Google AdSense (fallback). Unset = no Google script, no ads.txt, no verification tag.
# ca-pub-<digits>: also writes <meta name="google-adsense-account"> and /ads.txt at build.
VITE_ADSENSE_CLIENT=
# One display ad unit id (digits) per placement, after AdSense approval; unset = no AdSense there.
VITE_ADSENSE_SLOT_DISCOVER=
VITE_ADSENSE_SLOT_LIST=
VITE_ADSENSE_SLOT_FEED=
VITE_ADSENSE_SLOT_PROFILE=
VITE_ADSENSE_SLOT_CONTENT=
